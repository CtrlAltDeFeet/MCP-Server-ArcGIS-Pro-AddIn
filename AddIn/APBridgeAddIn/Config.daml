<ArcGIS defaultAssembly="ArcGISProMcpExtendedAddIn.dll" defaultNamespace="APBridgeAddIn" xmlns="http://schemas.esri.com/DADF/Registry">
  <AddInInfo id="{72dd2cd1-b63c-4c68-bab4-4ef6c41717fa}" version="3.0.1" desktopVersion="3.7.0" product="ArcGISPro">
    <Name>ArcGIS MCP Extended Hardened</Name>
    <Description>Hardened local MCP bridge for compatible AI clients, with configurable capabilities.</Description>
    <Image>Images\AddInDesktop32.png</Image>
    <Author>Local hardened build; upstream contributors credited in PROVENANCE.md</Author>
    <Company></Company>
    <Date>9/26/2026</Date>
    <Subject>Framework, Geoprocessing</Subject>
  </AddInInfo>
  <modules>
    <insertModule id="HardenedExtended_Module" className="Module1" autoLoad="false" caption="MCP Bridge">
      <groups>
        <group id="HardenedExtended_Group1" caption="MCP Extended Hardened" appearsOnAddInTab="true">
          <button refID="HardenedExtended_Button1" size="large" />
        </group>
      </groups>
      <controls>
        <button id="HardenedExtended_Button1" caption="Start / stop extended bridge" className="Button1" loadOnClick="true" smallImage="Images\AddInDesktop16.png" largeImage="Images\AddInDesktop32.png">
          <tooltip heading="MCP Bridge">Start or stop the hardened extended bridge<disabledText /></tooltip>
        </button>
      </controls>
    </insertModule>
  </modules>
</ArcGIS>
